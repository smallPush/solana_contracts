<?php

/**
 * @file
 * Primary module hooks for Solana Contracts.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;

/**
 * Implements hook_entity_view().
 * * Injects the "Sign with Solana" button if the user is a party to the contract
 * and hasn't signed yet.
 */
function solana_contracts_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // We only want to modify the view for 'solana_contract' entities in 'full' view mode.
  if ($entity->getEntityTypeId() !== 'solana_contract' || $view_mode !== 'full') {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    return;
  }

  $status = $entity->get('status')->value;
  $party_a_id = $entity->get('party_a')->target_id;
  $party_b_id = $entity->get('party_b')->target_id;
  $current_uid = $current_user->id();

  $can_sign = FALSE;

  // Logic: Check if current user is Party A and hasn't signed yet.
  if ($party_a_id == $current_uid) {
    if ($status === 'pending' || $status === 'signed_b') {
      $can_sign = TRUE;
    }
  }

  // Logic: Check if current user is Party B and hasn't signed yet.
  if ($party_b_id == $current_uid) {
    if ($status === 'pending' || $status === 'signed_a') {
      $can_sign = TRUE;
    }
  }

  // Check expiration.
  $expiration = $entity->get('expiration_date')->value;
  if ($expiration && time() > $expiration) {
    $can_sign = FALSE;
  }

  if ($can_sign) {
    $build['solana_sign_action'] = [
      '#type' => 'markup',
      // The ID is targeted by the JS file.
      '#markup' => '<div class="solana-signer-wrapper"><button id="btn-sign-solana" class="button button--primary">' . t('Sign with Solana Wallet') . '</button></div>',
      '#attached' => [
        'library' => ['solana_contracts/solana_signer'],
        'drupalSettings' => [
          'solana_contracts' => [
            'contract_id' => $entity->id(),
            'contract_title' => $entity->label(),
            // Secure token for API calls.
            'csrf_token' => \Drupal::service('csrf_token')->get('rest'),
          ],
        ],
      ],
      '#weight' => 100,
    ];
  }
}